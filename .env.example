# ==============================================================================
# Life Translator - Environment Configuration (Template)
# ==============================================================================
# Copy this file to '.env' and fill in your real API credentials.
# IMPORTANT: Never commit '.env' with real secrets to version control.
# ==============================================================================

# AI Provider Selection: 'gemini' (Recommended) or 'openai'
AI_PROVIDER=gemini

# Google Gemini Configuration
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI Configuration (Optional fallback/alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Server & Security Configuration
PORT=3001
MAX_DOCUMENT_SIZE_MB=10
